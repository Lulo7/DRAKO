# ==========================================
# DRAKO - Git Ignore
# ==========================================

# Dependencias de Node.js
node_modules/

# Angular
dist/
.angular/

# Variables de entorno
.env
.env.*
!.env.example

# Configuración con credenciales
config.js

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Archivos temporales
.tmp/
temp/

# Archivos del sistema operativo
.DS_Store
Thumbs.db

# Archivos de IDE
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Archivos de cobertura / testing
coverage/

# Archivos de compilación
*.tsbuildinfo

# Subidas de usuarios (imágenes y documentos en runtime)
Backend/Avatares/*
!Backend/Avatares/.gitkeep
Backend/Productos/*
!Backend/Productos/.gitkeep
Backend/Relojes/*
!Backend/Relojes/.gitkeep
Backend/Documentos/*
!Backend/Documentos/.gitkeep